input {
    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-speed 0.3
        accel-profile "flat"
    }

    trackpoint {
        // natural-scroll
    }

    // warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}
